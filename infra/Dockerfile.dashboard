FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
WORKDIR /app
COPY dashboard dashboard
COPY results/arm_simulation.json results/base_rates.json results/natural_experiment.json results/
COPY results/exp0/rules_summary.json results/exp0/
COPY models/model_s3.json models/
USER 10001:10001
ENTRYPOINT ["python","-m","dashboard.app","--host","0.0.0.0","--port","8080","--db","/app/data/gatekeeper.db"]
